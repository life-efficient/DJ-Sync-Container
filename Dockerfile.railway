FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ARG DJ_SYNC_VERSION=0.2.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "https://github.com/life-efficient/DJ-Sync/releases/download/v${DJ_SYNC_VERSION}/ytm_dropbox_dj_sync-${DJ_SYNC_VERSION}-py3-none-any.whl"

WORKDIR /app

COPY scripts/railway-start.sh /usr/local/bin/dj-sync-railway-start

RUN chmod +x /usr/local/bin/dj-sync-railway-start

ENTRYPOINT ["/usr/local/bin/dj-sync-railway-start"]
